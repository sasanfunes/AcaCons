# Base de datos (PostgreSQL 16)
DATABASE_URL="postgresql://acacons:acacons@localhost:5432/acacons?schema=public"
# Conexión directa (sin pooler) para migraciones; la crea la integración Neon de Vercel. Opcional.
# DATABASE_URL_UNPOOLED=""
# Base usada por los tests de integración (se resetea en cada corrida)
TEST_DATABASE_URL="postgresql://acacons:acacons@localhost:5432/acacons_test?schema=public"

# URL pública de la app (para links de emails, QR y certificados). En Vercel puede omitirse: se usa el dominio de producción.
APP_URL="http://localhost:3000"

# better-auth: secreto aleatorio de al menos 32 caracteres (openssl rand -base64 32)
BETTER_AUTH_SECRET="cambie-este-secreto-por-uno-aleatorio-de-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000"
# true en producción: exige verificar el email antes de ingresar
REQUIRE_EMAIL_VERIFICATION="false"

# Email: console (dev) | resend (prod)
EMAIL_DRIVER="console"
EMAIL_FROM="La Academia del Constructor <no-responder@ejemplo.com>"
RESEND_API_KEY=""

# Storage: local (dev) | db (archivos en PostgreSQL, recomendado en Vercel; máx. 4 MB por archivo) | s3 (Cloudflare R2 u otro S3-compatible)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Usuario administrador creado por el seed
ADMIN_EMAIL="admin@acacons.local"
ADMIN_PASSWORD="Admin12345!"
ADMIN_NAME="Administrador"
# true: el seed crea también el alumno de ejemplo en producción (estudiante@acacons.local / Estudiante123!)
SEED_DEMO_USER="false"

# Base usada por los tests end-to-end (Playwright); se vacía y se vuelve a sembrar en cada corrida
E2E_DATABASE_URL="postgresql://acacons:acacons@localhost:5432/acacons_e2e?schema=public"
